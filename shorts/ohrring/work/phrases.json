 "phrases": [
  {
   "text": "Ein goldener Ohrring – für Seeleute angeblich 'ne Versicherung.",
   "s": 0.0,
   "e": 3.095
  },
  {
   "text": "Und zwar … für den Fall,",
   "s": 3.264,
   "e": 4.112
  },
  {
   "text": "dass sie draufgehen.",
   "s": 4.37,
   "e": 5.8
  },
  {
   "text": "Stell dir vor:",
   "s": 6.116,
   "e": 6.652
  },
  {
   "text": "Ein Seemann überlebt 'nen Sturm nicht.",
   "s": 6.778,
   "e": 8.508
  },
  {
   "text": "Irgendwann wird er an einen fremden Strand gespült.",
   "s": 8.789,
   "e": 11.305
  },
  {
   "text": "Und wer ihn findet, sieht:",
   "s": 11.539,
   "e": 12.851
  },
  {
   "text": "Da hängt ein goldener Ohrring.",
   "s": 13.162,
   "e": 14.965
  },
  {
   "text": "Genug Kohle für 'ne ordentliche Beerdigung.",
   "s": 15.341,
   "e": 17.866
  },
  {
   "text": "Manche haben angeblich sogar ihren Heimathafen reingeritzt.",
   "s": 18.078,
   "e": 21.141
  },
  {
   "text": "Und das ist noch lange nicht alles.",
   "s": 21.444,
   "e": 23.058
  },
  {
   "text": "Einen Ohrring gab's angeblich, wenn du zum ersten Mal über den Äquator gesegelt bist.",
   "s": 23.377,
   "e": 28.272
  },
  {
   "text": "Oder wenn du's ums Kap Hoorn geschafft hast – eine der krassesten Ecken auf dem Meer.",
   "s": 28.571,
   "e": 33.228
  },
  {
   "text": "Manche dachten sogar:",
   "s": 33.7,
   "e": 34.786
  },
  {
   "text": "Gold im Ohr – und du ertrinkst nicht.",
   "s": 35.075,
   "e": 37.115
  },
  {
   "text": "Oder du siehst besser.",
   "s": 37.449,
   "e": 38.895
  },
  {
   "text": "Und die Jungs an den Kanonen haben angeblich Wachs an ihre Ohrringe gehängt.",
   "s": 39.377,
   "e": 42.821
  },
  {
   "text": "Als Ohrstöpsel.",
   "s": 43.22,
   "e": 44.122
  },
  {
   "text": "Weil's da unten ordentlich geknallt hat.",
   "s": 44.578,
   "e": 46.491
  },
  {
   "text": "Der Haken an der Sache:",
   "s": 46.776,
   "e": 47.708
  },
  {
   "text": "Für das meiste davon gibt's kaum Beweise.",
   "s": 48.035,
   "e": 49.811
  },
  {
   "text": "Klar, Seeleute hatten echt Ohrringe.",
   "s": 50.042,
   "e": 51.419
  },
  {
   "text": "Aber warum genau?",
   "s": 51.578,
   "e": 52.497
  },
  {
   "text": "Vielleicht war so'n Ohrring manchmal … einfach nur ein Ohrring.",
   "s": 52.868,
   "e": 56.11
  }
 ],
