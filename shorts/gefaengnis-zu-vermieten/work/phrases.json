 "phrases": [
  {
   "text": "Ein Land in Europa hat ein seltsames Problem:",
   "s": 0.0,
   "e": 2.15
  },
  {
   "text": "Es hat zu wenige Verbrecher.",
   "s": 2.41,
   "e": 3.72
  },
  {
   "text": "Die Strafen werden kürzer, die Kriminalität sinkt.",
   "s": 4.06,
   "e": 6.52
  },
  {
   "text": "In zehn Jahren schrumpft die Zahl der Häftlinge fast um die Hälfte.",
   "s": 6.78,
   "e": 9.59
  },
  {
   "text": "Über zwanzig Gefängnisse machen dicht.",
   "s": 9.96,
   "e": 11.7
  },
  {
   "text": "Aber was macht man mit den leeren Zellen?",
   "s": 12.03,
   "e": 13.72
  },
  {
   "text": "Und mit den Wärtern, die ihren Job verlieren?",
   "s": 13.99,
   "e": 15.69
  },
  {
   "text": "Die Lösung: Man vermietet sie.",
   "s": 16.04,
   "e": 17.59
  },
  {
   "text": "Ein Nachbarland schickt rund fünfhundert seiner Häftlinge über die Grenze.",
   "s": 17.94,
   "e": 21.29
  },
  {
   "text": "Ein Land im hohen Norden zahlt jedes Jahr rund fünfundzwanzig Millionen Euro – für ein ganzes Gefängnis.",
   "s": 21.61,
   "e": 27.04
  },
  {
   "text": "Die Häftlinge züchten dort Hühner und bauen Gemüse an.",
   "s": 27.62,
   "e": 30.39
  },
  {
   "text": "Viele kommen sogar freiwillig – unter anderem, weil Tabak und Lebensmittel dort billiger sind.",
   "s": 30.77,
   "e": 35.36
  },
  {
   "text": "Nur eine Regel gibt's:",
   "s": 35.73,
   "e": 37.11
  },
  {
   "text": "Spätestens zwei Monate vor der Entlassung müssen sie zurück nach Hause.",
   "s": 37.35,
   "e": 40.77
  },
  {
   "text": "Damit keiner auf die Idee kommt … dort Asyl zu beantragen.",
   "s": 41.2,
   "e": 44.42
  },
  {
   "text": "Und welches Land ist das?",
   "s": 44.83,
   "e": 45.9
  },
  {
   "text": "Die Niederlande.",
   "s": 46.54,
   "e": 47.39
  }
 ],
