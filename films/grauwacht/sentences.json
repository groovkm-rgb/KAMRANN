[
{
"text": "In der Nacht, als sie mich ins Meer geworfen haben, war ich schon acht Jahre tot.",
"para": 0,
"head": false,
"n": 65,
"start": 0.11,
"end": 4.6,
"dtw": 0.0,
"start2": 0.11
},
{
"text": "Zumindest für die Welt da draußen.",
"para": 1,
"head": false,
"n": 30,
"start": 5.14,
"end": 6.91,
"dtw": 5.12,
"start2": 5.14
},
{
"text": "Für meine Mutter, für meine Freunde, für Greta.",
"para": 1,
"head": false,
"n": 39,
"start": 7.32,
"end": 10.2,
"dtw": 7.32,
"start2": 7.32
},
{
"text": "Für alle war Jakob Brenner nur noch ein Name in einer Akte.",
"para": 1,
"head": false,
"n": 49,
"start": 10.62,
"end": 14.09,
"dtw": 10.64,
"start2": 10.62
},
{
"text": "Ein Verbrecher.",
"para": 1,
"head": false,
"n": 15,
"start": 14.32,
"end": 15.18,
"dtw": 14.32,
"start2": 14.32
},
{
"text": "Einer, über den man nicht mehr spricht.",
"para": 1,
"head": false,
"n": 33,
"start": 15.53,
"end": 18.44,
"dtw": 15.52,
"start2": 15.53
},
{
"text": "Ich lag in einem groben Leinensack, eingenäht wie ein Stück Fleisch.",
"para": 2,
"head": false,
"n": 58,
"start": 18.99,
"end": 23.11,
"dtw": 19.0,
"start2": 18.99
},
{
"text": "An meinen Füßen hing eine Eisenkugel.",
"para": 2,
"head": false,
"n": 33,
"start": 23.57,
"end": 27.71,
"dtw": 23.56,
"start2": 23.57
},
{
"text": "Zwei Wärter trugen mich die Treppe hoch, und ich hab gehört, wie einer gesagt hat: „Der Alte ist ja schwerer, als er aussieht.“",
"para": 2,
"head": false,
"n": 100,
"start": 28.12,
"end": 35.23,
"dtw": 25.6,
"start2": 25.6
},
{
"text": "Dann der Wind.",
"para": 3,
"head": false,
"n": 13,
"start": 35.45,
"end": 36.16,
"dtw": 33.68,
"start2": 33.67
},
{
"text": "Dann das Rauschen.",
"para": 3,
"head": false,
"n": 17,
"start": 36.65,
"end": 37.2,
"dtw": 34.92,
"start2": 35.45
},
{
"text": "Und dann bin ich gefallen.",
"para": 3,
"head": false,
"n": 23,
"start": 37.5,
"end": 38.29,
"dtw": 36.72,
"start2": 36.65
},
{
"text": "Aber ich muss vorne anfangen.",
"para": 4,
"head": false,
"n": 26,
"start": 38.93,
"end": 40.56,
"dtw": 39.0,
"start2": 38.93
},
{
"text": "Teil 1: Der Hafen",
"para": 5,
"head": true,
"n": 18,
"start": 41.31,
"end": 42.0,
"dtw": 41.28,
"start2": 41.31
},
{
"text": "Lübeck, Frühjahr 1903.",
"para": 6,
"head": false,
"n": 35,
"start": 42.64,
"end": 45.42,
"dtw": 43.76,
"start2": 43.99
},
{
"text": "Ich war vierundzwanzig, Schiffszimmermann auf der Werft von Reeder Lindqvist.",
"para": 6,
"head": false,
"n": 68,
"start": 45.89,
"end": 50.3,
"dtw": 45.92,
"start2": 45.89
},
{
"text": "Viel hatte ich nicht, aber ich hatte gute Hände, einen ehrlichen Namen und Greta.",
"para": 6,
"head": false,
"n": 67,
"start": 50.48,
"end": 53.39,
"dtw": 50.8,
"start2": 50.73
},
{
"text": "Im Sommer wollten wir heiraten.",
"para": 6,
"head": false,
"n": 28,
"start": 53.82,
"end": 55.67,
"dtw": 56.0,
"start2": 56.03
},
{
"text": "Und ich hatte Konrad Haller.",
"para": 7,
"head": false,
"n": 25,
"start": 56.03,
"end": 57.55,
"dtw": 58.04,
"start2": 58.01
},
{
"text": "Den Buchhalter vom Reeder.",
"para": 7,
"head": false,
"n": 24,
"start": 58.01,
"end": 60.04,
"dtw": 60.52,
"start2": 60.53
},
{
"text": "Immer freundlich, immer mit einem Lächeln, und immer hat er Greta ein bisschen zu lange angeschaut.",
"para": 7,
"head": false,
"n": 83,
"start": 60.53,
"end": 65.19,
"dtw": 62.8,
"start2": 62.82
},
{
"text": "Im April hat Lindqvist mich zum Vorarbeiter gemacht.",
"para": 8,
"head": false,
"n": 46,
"start": 65.55,
"end": 68.42,
"dtw": 68.92,
"start2": 68.94
},
{
"text": "An dem Abend hab ich gefeiert wie ein König.",
"para": 8,
"head": false,
"n": 37,
"start": 68.94,
"end": 71.56,
"dtw": 71.96,
"start2": 71.97
},
{
"text": "Drei Tage später brannte das Lager am Hafen ab.",
"para": 8,
"head": false,
"n": 40,
"start": 71.97,
"end": 74.51,
"dtw": 75.12,
"start2": 75.15
},
{
"text": "Und in meiner Kiste in der Werkstatt fanden sie Briefe.",
"para": 8,
"head": false,
"n": 47,
"start": 75.15,
"end": 77.77,
"dtw": 78.12,
"start2": 78.1
},
{
"text": "Briefe an Schmuggler, mit meiner Unterschrift.",
"para": 8,
"head": false,
"n": 41,
"start": 78.1,
"end": 81.15,
"dtw": 81.52,
"start2": 81.51
},
{
"text": "Dazu Geld, das aus der Kasse fehlte.",
"para": 8,
"head": false,
"n": 30,
"start": 81.51,
"end": 84.1,
"dtw": 84.56,
"start2": 84.54
},
{
"text": "Ich hab diese Briefe nie geschrieben.",
"para": 9,
"head": false,
"n": 33,
"start": 84.54,
"end": 88.09,
"dtw": 86.32,
"start2": 86.32
},
{
"text": "Aber die Schrift sah aus wie meine.",
"para": 9,
"head": false,
"n": 30,
"start": 88.45,
"end": 90.0,
"dtw": 88.44,
"start2": 88.45
},
{
"text": "Und wer hatte meine Schrift jeden Tag in den Lohnbüchern vor Augen?",
"para": 9,
"head": false,
"n": 57,
"start": 90.33,
"end": 94.0,
"dtw": 90.36,
"start2": 90.33
},
{
"text": "Konrad Haller.",
"para": 9,
"head": false,
"n": 14,
"start": 94.29,
"end": 95.3,
"dtw": 94.48,
"start2": 94.51
},
{
"text": "Der Prozess hat keine zwei Stunden gedauert.",
"para": 10,
"head": false,
"n": 39,
"start": 95.81,
"end": 97.97,
"dtw": 95.8,
"start2": 95.81
},
{
"text": "Zwanzig Jahre.",
"para": 10,
"head": false,
"n": 14,
"start": 98.3,
"end": 99.37,
"dtw": 98.32,
"start2": 98.3
},
{
"text": "Festung Grauwacht.",
"para": 10,
"head": false,
"n": 18,
"start": 99.73,
"end": 101.03,
"dtw": 99.72,
"start2": 99.73
},
{
"text": "Teil 2: Die Festung",
"para": 11,
"head": true,
"n": 20,
"start": 101.4,
"end": 101.81,
"dtw": 101.36,
"start2": 101.4
},
{
"text": "Grauwacht ist ein Felsen in der Ostsee, zwei Stunden mit dem Boot vom Festland.",
"para": 12,
"head": false,
"n": 66,
"start": 102.0,
"end": 105.61,
"dtw": 103.48,
"start2": 103.48
},
{
"text": "Graue Mauern, grauer Himmel, graues Wasser.",
"para": 12,
"head": false,
"n": 37,
"start": 105.95,
"end": 108.17,
"dtw": 109.92,
"start2": 109.9
},
{
"text": "Wer da reinkommt, kommt nicht mehr raus.",
"para": 12,
"head": false,
"n": 34,
"start": 108.4,
"end": 109.56,
"dtw": 112.96,
"start2": 112.94
},
{
"text": "Das sagten die Wärter gleich am ersten Tag.",
"para": 12,
"head": false,
"n": 37,
"start": 109.9,
"end": 112.58,
"dtw": 115.72,
"start2": 115.52
},
{
"text": "Meine Zelle war drei Schritte breit und vier Schritte lang.",
"para": 13,
"head": false,
"n": 51,
"start": 112.94,
"end": 115.08,
"dtw": 119.0,
"start2": 119.01
},
{
"text": "Ein Strohsack, ein Eimer, ein Fenster so klein wie ein Gesangbuch.",
"para": 13,
"head": false,
"n": 55,
"start": 115.52,
"end": 118.48,
"dtw": 123.6,
"start2": 123.61
},
{
"text": "Hoch oben, damit man nur den Himmel sieht.",
"para": 13,
"head": false,
"n": 35,
"start": 119.01,
"end": 119.77,
"dtw": 128.76,
"start2": 128.76
},
{
"text": "Im ersten Jahr hab ich geschrien.",
"para": 14,
"head": false,
"n": 29,
"start": 119.98,
"end": 123.39,
"dtw": 131.88,
"start2": 131.87
},
{
"text": "Im zweiten hab ich geweint.",
"para": 14,
"head": false,
"n": 24,
"start": 123.61,
"end": 125.6,
"dtw": 134.24,
"start2": 134.25
},
{
"text": "Im dritten hab ich nur noch dagelegen und die Risse in der Decke gezählt.",
"para": 14,
"head": false,
"n": 61,
"start": 126.04,
"end": 131.35,
"dtw": 136.2,
"start2": 136.22
},
{
"text": "Siebenhundertzwölf.",
"para": 14,
"head": false,
"n": 20,
"start": 131.87,
"end": 133.89,
"dtw": 139.88,
"start2": 139.88
},
{
"text": "Ich weiß es noch genau.",
"para": 14,
"head": false,
"n": 20,
"start": 134.25,
"end": 135.93,
"dtw": 141.36,
"start2": 141.36
},
{
"text": "Und dann, eines Nachts, hat es geklopft.",
"para": 15,
"head": false,
"n": 33,
"start": 136.22,
"end": 142.52,
"dtw": 142.96,
"start2": 142.91
},
{
"text": "Unten in der Wand.",
"para": 15,
"head": false,
"n": 16,
"start": 142.91,
"end": 143.46,
"dtw": 145.88,
"start2": 145.88
},
{
"text": "Ganz leise.",
"para": 15,
"head": false,
"n": 11,
"start": 143.7,
"end": 145.52,
"dtw": 147.36,
"start2": 147.38
},
{
"text": "Tock.",
"para": 16,
"head": false,
"n": 6,
"start": 145.88,
"end": 147.09,
"dtw": 148.4,
"start2": 148.46
},
{
"text": "Tock-tock.",
"para": 16,
"head": false,
"n": 10,
"start": 147.38,
"end": 148.07,
"dtw": 149.0,
"start2": 149.02
},
{
"text": "Tock.",
"para": 16,
"head": false,
"n": 6,
"start": 148.46,
"end": 148.81,
"dtw": 149.56,
"start2": 149.02
},
{
"text": "Teil 3: Der Alte",
"para": 17,
"head": true,
"n": 17,
"start": 149.02,
"end": 154.72,
"dtw": 149.56,
"start2": 149.02
},
{
"text": "Hinter der Wand saß ein Mann, der sich seit elf Jahren einen Tunnel grub.",
"para": 18,
"head": false,
"n": 60,
"start": 155.27,
"end": 160.79,
"dtw": 151.08,
"start2": 151.08
},
{
"text": "Mit einem Löffelstiel.",
"para": 18,
"head": false,
"n": 21,
"start": 161.4,
"end": 164.44,
"dtw": 155.24,
"start2": 155.27
},
{
"text": "Er hatte sich verrechnet und war statt am Außenhof bei mir gelandet.",
"para": 18,
"head": false,
"n": 58,
"start": 164.9,
"end": 167.48,
"dtw": 157.16,
"start2": 157.15
},
{
"text": "Als der erste Stein rausfiel, sah ich zuerst nur ein Auge.",
"para": 19,
"head": false,
"n": 48,
"start": 167.92,
"end": 169.39,
"dtw": 161.4,
"start2": 161.4
},
{
"text": "Dann einen weißen Bart.",
"para": 19,
"head": false,
"n": 21,
"start": 170.09,
"end": 171.92,
"dtw": 165.52,
"start2": 165.51
},
{
"text": "Und dann hat er gelacht.",
"para": 19,
"head": false,
"n": 21,
"start": 172.27,
"end": 174.68,
"dtw": 167.0,
"start2": 166.97
},
{
"text": "„Na sowas“, hat er gesagt.",
"para": 19,
"head": false,
"n": 20,
"start": 175.21,
"end": 176.49,
"dtw": 170.08,
"start2": 170.09
},
{
"text": "„Ich wollte in die Freiheit, und stattdessen find ich einen Nachbarn.“",
"para": 19,
"head": false,
"n": 58,
"start": 176.73,
"end": 180.66,
"dtw": 172.56,
"start2": 172.27
},
{
"text": "Er hieß Anselm Weidner.",
"para": 20,
"head": false,
"n": 21,
"start": 180.86,
"end": 181.67,
"dtw": 177.16,
"start2": 176.94
},
{
"text": "Früher Professor in Heidelberg.",
"para": 20,
"head": false,
"n": 29,
"start": 181.96,
"end": 183.61,
"dtw": 179.12,
"start2": 179.12
},
{
"text": "Physik, Sternkunde, Chemie, Medizin, er wusste einfach alles.",
"para": 20,
"head": false,
"n": 51,
"start": 183.85,
"end": 186.34,
"dtw": 181.16,
"start2": 180.86
},
{
"text": "Er hatte ein paar mächtigen Leuten die Wahrheit ins Gesicht gesagt, und das hatte gereicht, um ihn hier verschwinden zu lassen.",
"para": 20,
"head": false,
"n": 106,
"start": 186.72,
"end": 193.51,
"dtw": 186.96,
"start2": 186.95
},
{
"text": "Von da an haben wir jede Nacht den Stein rausgenommen.",
"para": 21,
"head": false,
"n": 46,
"start": 194.15,
"end": 197.08,
"dtw": 194.12,
"start2": 194.15
},
{
"text": "Teil 4: Die Schule im Dunkeln",
"para": 22,
"head": true,
"n": 28,
"start": 197.69,
"end": 200.14,
"dtw": 197.8,
"start2": 197.69
},
{
"text": "„Ein Kopf ist das Einzige, was sie dir nicht wegnehmen können“, hat Anselm gesagt.",
"para": 23,
"head": false,
"n": 66,
"start": 200.6,
"end": 204.81,
"dtw": 200.64,
"start2": 200.6
},
{
"text": "„Also lass ihn uns füllen.“",
"para": 23,
"head": false,
"n": 22,
"start": 205.21,
"end": 206.85,
"dtw": 205.2,
"start2": 205.21
},
{
"text": "Und das haben wir gemacht.",
"para": 24,
"head": false,
"n": 23,
"start": 207.49,
"end": 209.19,
"dtw": 207.56,
"start2": 207.49
},
{
"text": "Jahre lang.",
"para": 24,
"head": false,
"n": 11,
"start": 209.42,
"end": 210.17,
"dtw": 209.44,
"start2": 209.42
},
{
"text": "Er hat mir Rechnen beigebracht, mit Strichen im Staub.",
"para": 25,
"head": false,
"n": 46,
"start": 210.67,
"end": 214.11,
"dtw": 210.68,
"start2": 210.67
},
{
"text": "Er hat mir erklärt, warum der Mond das Meer zieht und wann Ebbe und Flut kommen.",
"para": 25,
"head": false,
"n": 65,
"start": 214.63,
"end": 219.58,
"dtw": 214.64,
"start2": 214.63
},
{
"text": "Durch mein kleines Fenster hat er mir die Sterne gezeigt: den Polarstern, den Großen Wagen, und wie man mit ihnen nachts übers Wasser findet.",
"para": 25,
"head": false,
"n": 116,
"start": 219.85,
"end": 229.2,
"dtw": 219.84,
"start2": 219.85
},
{
"text": "Er hat mir beigebracht, wie man aus Ruß und Wasser Tinte macht.",
"para": 26,
"head": false,
"n": 52,
"start": 229.49,
"end": 234.65,
"dtw": 230.96,
"start2": 230.97
},
{
"text": "Wie man eine Wunde reinigt.",
"para": 26,
"head": false,
"n": 24,
"start": 234.97,
"end": 236.64,
"dtw": 234.96,
"start2": 234.97
},
{
"text": "Warum Salzwasser einen Körper trägt, wenn man ruhig bleibt und nicht zappelt.",
"para": 26,
"head": false,
"n": 66,
"start": 236.86,
"end": 242.63,
"dtw": 236.88,
"start2": 236.86
},
{
"text": "Französisch, Englisch, ein bisschen Latein.",
"para": 26,
"head": false,
"n": 38,
"start": 243.1,
"end": 245.99,
"dtw": 243.12,
"start2": 243.1
},
{
"text": "Und er hat mir beigebracht, Schriften zu lesen.",
"para": 26,
"head": false,
"n": 40,
"start": 246.35,
"end": 248.93,
"dtw": 246.36,
"start2": 246.35
},
{
"text": "Wie jeder Mensch den Stift anders hält, wie jeder Druck seine eigene Spur hinterlässt.",
"para": 26,
"head": false,
"n": 73,
"start": 249.32,
"end": 254.34,
"dtw": 249.36,
"start2": 249.32
},
{
"text": "„Eine gefälschte Unterschrift“, hat er gesagt, „ist wie eine Lüge.",
"para": 27,
"head": false,
"n": 53,
"start": 254.88,
"end": 259.5,
"dtw": 254.88,
"start2": 254.88
},
{
"text": "Sie sieht richtig aus, aber sie zittert.“",
"para": 27,
"head": false,
"n": 34,
"start": 259.88,
"end": 262.85,
"dtw": 259.92,
"start2": 259.88
},
{
"text": "Und er hat mir das Wichtigste beigebracht: „Hass ist ein schweres Gepäck, Jakob.",
"para": 28,
"head": false,
"n": 66,
"start": 263.37,
"end": 268.39,
"dtw": 263.44,
"start2": 263.37
},
{
"text": "Wer damit schwimmt, geht unter.“",
"para": 28,
"head": false,
"n": 27,
"start": 268.72,
"end": 270.45,
"dtw": 268.72,
"start2": 268.72
},
{
"text": "Ich bin in diese Zelle als dummer Junge gekommen.",
"para": 29,
"head": false,
"n": 42,
"start": 271.03,
"end": 273.55,
"dtw": 271.04,
"start2": 271.03
},
{
"text": "Nach fünf Jahren mit Anselm war ich ein anderer Mensch.",
"para": 29,
"head": false,
"n": 47,
"start": 273.99,
"end": 278.13,
"dtw": 273.96,
"start2": 273.99
},
{
"text": "Teil 5: Das Geheimnis",
"para": 30,
"head": true,
"n": 22,
"start": 278.7,
"end": 279.67,
"dtw": 277.08,
"start2": 277.1
},
{
"text": "Im Winter 1911 wurde Anselm krank.",
"para": 31,
"head": false,
"n": 44,
"start": 280.22,
"end": 283.17,
"dtw": 280.2,
"start2": 280.22
},
{
"text": "Erst ein Husten, dann Fieber.",
"para": 31,
"head": false,
"n": 25,
"start": 283.53,
"end": 285.36,
"dtw": 283.52,
"start2": 283.53
},
{
"text": "Er wusste, was es war, er war ja Arzt.",
"para": 31,
"head": false,
"n": 29,
"start": 285.71,
"end": 288.27,
"dtw": 285.72,
"start2": 285.71
},
{
"text": "In seiner letzten Nacht hat er mich ganz nah rangeholt.",
"para": 32,
"head": false,
"n": 47,
"start": 288.86,
"end": 291.81,
"dtw": 288.84,
"start2": 288.86
},
{
"text": "Seine Hand war kalt wie ein Stein.",
"para": 32,
"head": false,
"n": 29,
"start": 292.09,
"end": 294.63,
"dtw": 292.08,
"start2": 292.09
},
{
"text": "„Hör zu“, hat er geflüstert.",
"para": 33,
"head": false,
"n": 22,
"start": 295.1,
"end": 296.77,
"dtw": 295.04,
"start2": 295.1
},
{
"text": "„Meine Familie war mal reich.",
"para": 33,
"head": false,
"n": 25,
"start": 297.08,
"end": 298.86,
"dtw": 297.08,
"start2": 297.08
},
{
"text": "Sehr reich.",
"para": 33,
"head": false,
"n": 11,
"start": 299.09,
"end": 299.94,
"dtw": 299.08,
"start2": 299.09
},
{
"text": "Bevor sie mich geholt haben, hab ich alles versteckt.",
"para": 33,
"head": false,
"n": 45,
"start": 300.26,
"end": 304.16,
"dtw": 300.36,
"start2": 300.26
},
{
"text": "Gold, Edelsteine, Papiere.",
"para": 33,
"head": false,
"n": 23,
"start": 304.46,
"end": 306.14,
"dtw": 303.72,
"start2": 303.74
},
{
"text": "Auf der Insel Möwenholm, nördlich von Rügen.",
"para": 33,
"head": false,
"n": 38,
"start": 306.51,
"end": 308.9,
"dtw": 306.52,
"start2": 306.51
},
{
"text": "Da steht ein alter, kaputter Leuchtturm.",
"para": 33,
"head": false,
"n": 35,
"start": 309.16,
"end": 311.51,
"dtw": 309.16,
"start2": 309.16
},
{
"text": "Von der Tür aus vierzig Schritte Richtung Polarstern.",
"para": 33,
"head": false,
"n": 47,
"start": 311.94,
"end": 315.46,
"dtw": 311.92,
"start2": 311.94
},
{
"text": "Da ist ein Felsen mit einem Kreuz drauf.",
"para": 33,
"head": false,
"n": 34,
"start": 315.81,
"end": 318.31,
"dtw": 315.92,
"start2": 315.81
},
{
"text": "Darunter.“",
"para": 33,
"head": false,
"n": 10,
"start": 318.75,
"end": 319.55,
"dtw": 318.76,
"start2": 318.75
},
{
"text": "Ich hab den Kopf geschüttelt.",
"para": 34,
"head": false,
"n": 26,
"start": 319.99,
"end": 321.4,
"dtw": 320.0,
"start2": 319.99
},
{
"text": "„Was soll ich mit Gold, ich komm hier doch nie raus.“",
"para": 34,
"head": false,
"n": 41,
"start": 321.75,
"end": 324.74,
"dtw": 321.68,
"start2": 321.75
},
{
"text": "Er hat gelächelt.",
"para": 35,
"head": false,
"n": 16,
"start": 325.26,
"end": 326.31,
"dtw": 325.24,
"start2": 325.26
},
{
"text": "„Doch.",
"para": 35,
"head": false,
"n": 6,
"start": 326.59,
"end": 327.09,
"dtw": 326.76,
"start2": 326.59
},
{
"text": "Du kommst raus.",
"para": 35,
"head": false,
"n": 14,
"start": 327.52,
"end": 328.53,
"dtw": 327.56,
"start2": 327.52
},
{
"text": "Und zwar mit mir.“",
"para": 35,
"head": false,
"n": 15,
"start": 329.01,
"end": 329.99,
"dtw": 329.04,
"start2": 329.01
},
{
"text": "Am Morgen war er tot.",
"para": 36,
"head": false,
"n": 18,
"start": 330.55,
"end": 331.92,
"dtw": 330.56,
"start2": 330.55
},
{
"text": "Teil 6: Der Sack",
"para": 37,
"head": true,
"n": 18,
"start": 332.45,
"end": 333.28,
"dtw": 332.44,
"start2": 332.45
},
{
"text": "Die Toten von Grauwacht werden nicht begraben.",
"para": 38,
"head": false,
"n": 41,
"start": 333.86,
"end": 337.35,
"dtw": 335.08,
"start2": 335.09
},
{
"text": "Sie werden in einen Sack genäht, kriegen eine Kugel an die Füße und werden nachts von der Westmauer ins Meer geworfen.",
"para": 38,
"head": false,
"n": 98,
"start": 337.69,
"end": 344.55,
"dtw": 337.68,
"start2": 337.69
},
{
"text": "Das hatte Anselm mir oft erzählt.",
"para": 38,
"head": false,
"n": 29,
"start": 345.02,
"end": 346.92,
"dtw": 345.04,
"start2": 345.02
},
{
"text": "Am Abend haben die Wärter seinen Körper in den Sack gelegt und zugenäht.",
"para": 39,
"head": false,
"n": 61,
"start": 347.62,
"end": 351.66,
"dtw": 347.6,
"start2": 347.62
},
{
"text": "Dann sind sie Abendessen gegangen.",
"para": 39,
"head": false,
"n": 31,
"start": 352.19,
"end": 354.36,
"dtw": 352.28,
"start2": 352.19
},
{
"text": "Ich bin durch das Loch gekrochen, hab mit meinem angeschliffenen Löffel die Naht aufgemacht und Anselm rausgeholt.",
"para": 40,
"head": false,
"n": 98,
"start": 355.06,
"end": 362.37,
"dtw": 355.08,
"start2": 355.06
},
{
"text": "Ich hab ihn in mein Bett gelegt, das Gesicht zur Wand, die Decke bis über den Kopf.",
"para": 40,
"head": false,
"n": 66,
"start": 362.91,
"end": 367.77,
"dtw": 363.24,
"start2": 362.91
},
{
"text": "„Danke, mein Freund“, hab ich gesagt.",
"para": 40,
"head": false,
"n": 29,
"start": 368.56,
"end": 370.33,
"dtw": 368.56,
"start2": 368.56
},
{
"text": "Dann bin ich selber in den Sack gekrochen.",
"para": 40,
"head": false,
"n": 36,
"start": 370.92,
"end": 372.62,
"dtw": 370.92,
"start2": 370.92
},
{
"text": "Den Löffel hab ich fest in der Hand gehalten und die Naht von innen, so gut es ging, zusammengezogen.",
"para": 40,
"head": false,
"n": 82,
"start": 373.07,
"end": 378.02,
"dtw": 373.08,
"start2": 373.07
},
{
"text": "Um Mitternacht kamen sie.",
"para": 41,
"head": false,
"n": 23,
"start": 378.37,
"end": 379.89,
"dtw": 378.36,
"start2": 378.37
},
{
"text": "Und jetzt sind wir wieder da, wo alles angefangen hat.",
"para": 42,
"head": false,
"n": 45,
"start": 380.78,
"end": 383.13,
"dtw": 380.8,
"start2": 380.78
},
{
"text": "Der Wind.",
"para": 42,
"head": false,
"n": 9,
"start": 383.31,
"end": 384.81,
"dtw": 385.16,
"start2": 385.17
},
{
"text": "Das Rauschen.",
"para": 42,
"head": false,
"n": 13,
"start": 385.17,
"end": 385.87,
"dtw": 386.12,
"start2": 386.12
},
{
"text": "Der Fall.",
"para": 42,
"head": false,
"n": 9,
"start": 386.12,
"end": 387.27,
"dtw": 387.4,
"start2": 387.47
},
{
"text": "Das Wasser war eiskalt.",
"para": 43,
"head": false,
"n": 21,
"start": 387.47,
"end": 387.82,
"dtw": 388.28,
"start2": 388.23
},
{
"text": "Wie tausend Messer.",
"para": 43,
"head": false,
"n": 18,
"start": 388.23,
"end": 391.8,
"dtw": 390.28,
"start2": 390.28
},
{
"text": "Die Kugel hat mich runtergezogen, immer tiefer.",
"para": 43,
"head": false,
"n": 41,
"start": 392.21,
"end": 395.44,
"dtw": 392.28,
"start2": 392.21
},
{
"text": "Ich hab den Löffel in den Stoff gerammt, wieder und wieder, bis ein Riss kam.",
"para": 43,
"head": false,
"n": 62,
"start": 395.73,
"end": 400.3,
"dtw": 395.84,
"start2": 395.73
},
{
"text": "Dann der Knoten an den Füßen.",
"para": 43,
"head": false,
"n": 25,
"start": 400.75,
"end": 402.37,
"dtw": 400.8,
"start2": 400.75
},
{
"text": "Meine Lunge hat gebrannt.",
"para": 43,
"head": false,
"n": 23,
"start": 402.81,
"end": 404.22,
"dtw": 402.8,
"start2": 402.81
},
{
"text": "Ich dachte, das war's.",
"para": 43,
"head": false,
"n": 18,
"start": 404.43,
"end": 405.85,
"dtw": 404.52,
"start2": 404.43
},
{
"text": "Dann war ich frei.",
"para": 44,
"head": false,
"n": 16,
"start": 406.35,
"end": 407.92,
"dtw": 407.04,
"start2": 407.2
},
{
"text": "Ich bin nach oben, hab nach Luft geschnappt und den Himmel gesehen.",
"para": 44,
"head": false,
"n": 56,
"start": 408.48,
"end": 412.89,
"dtw": 408.48,
"start2": 408.48
},
{
"text": "Zum ersten Mal seit acht Jahren den ganzen Himmel.",
"para": 44,
"head": false,
"n": 43,
"start": 413.59,
"end": 416.84,
"dtw": 413.56,
"start2": 413.59
},
{
"text": "Teil 7: Die Fischer",
"para": 45,
"head": true,
"n": 22,
"start": 417.15,
"end": 418.53,
"dtw": 417.12,
"start2": 417.15
},
{
"text": "Ich hab mich auf den Rücken gelegt, ganz ruhig, wie Anselm es mir beigebracht hatte.",
"para": 46,
"head": false,
"n": 69,
"start": 418.98,
"end": 423.17,
"dtw": 419.12,
"start2": 418.98
},
{
"text": "Die Flut lief Richtung Osten, weg von der Festung.",
"para": 46,
"head": false,
"n": 42,
"start": 423.65,
"end": 426.67,
"dtw": 423.64,
"start2": 423.65
},
{
"text": "Ich hab mich treiben lassen und mich am Polarstern orientiert.",
"para": 46,
"head": false,
"n": 54,
"start": 427.29,
"end": 431.21,
"dtw": 427.32,
"start2": 427.29
},
{
"text": "Gegen Morgen hab ich einen kleinen Felsen erreicht, voller Möwendreck.",
"para": 47,
"head": false,
"n": 61,
"start": 431.87,
"end": 436.1,
"dtw": 431.88,
"start2": 431.87
},
{
"text": "Da hab ich gelegen und gezittert, bis die Sonne aufging.",
"para": 47,
"head": false,
"n": 47,
"start": 436.93,
"end": 440.43,
"dtw": 436.92,
"start2": 436.93
},
{
"text": "Am Mittag kam ein Fischkutter vorbei.",
"para": 48,
"head": false,
"n": 33,
"start": 441.2,
"end": 444.2,
"dtw": 441.2,
"start2": 441.2
},
{
"text": "Drei Männer aus Rügen, mit Bärten wie Seehunde.",
"para": 48,
"head": false,
"n": 40,
"start": 444.64,
"end": 448.36,
"dtw": 444.64,
"start2": 444.64
},
{
"text": "Ich hab gewinkt, bis meine Arme nicht mehr konnten.",
"para": 48,
"head": false,
"n": 43,
"start": 448.76,
"end": 452.05,
"dtw": 448.76,
"start2": 448.76
},
{
"text": "„Schiffbrüchig“, hab ich gesagt.",
"para": 49,
"head": false,
"n": 27,
"start": 452.53,
"end": 454.34,
"dtw": 452.56,
"start2": 452.53
},
{
"text": "„Unser Schoner ist gesunken.",
"para": 49,
"head": false,
"n": 25,
"start": 454.91,
"end": 457.9,
"dtw": 454.92,
"start2": 454.91
},
{
"text": "Ich bin der Einzige.“",
"para": 49,
"head": false,
"n": 18,
"start": 458.53,
"end": 460.19,
"dtw": 456.76,
"start2": 456.76
},
{
"text": "Der Kapitän hieß Hinnerk.",
"para": 50,
"head": false,
"n": 23,
"start": 460.47,
"end": 462.52,
"dtw": 458.52,
"start2": 458.53
},
{
"text": "Er hat mich lange angeschaut.",
"para": 50,
"head": false,
"n": 26,
"start": 462.85,
"end": 465.01,
"dtw": 460.68,
"start2": 460.47
},
{
"text": "Meine Haare bis zur Schulter, meine Haut weiß wie Papier.",
"para": 50,
"head": false,
"n": 48,
"start": 465.44,
"end": 468.52,
"dtw": 462.84,
"start2": 462.85
},
{
"text": "Ich glaube, er hat mir kein Wort geglaubt.",
"para": 50,
"head": false,
"n": 35,
"start": 468.82,
"end": 471.13,
"dtw": 467.88,
"start2": 467.89
},
{
"text": "Aber er hat mir eine Decke gegeben und einen Becher heißen Tee mit Rum.",
"para": 50,
"head": false,
"n": 59,
"start": 471.73,
"end": 476.45,
"dtw": 471.8,
"start2": 471.73
},
{
"text": "„Wer gut mit Holz kann, ist bei uns willkommen“, hat er nur gesagt.",
"para": 50,
"head": false,
"n": 52,
"start": 477.28,
"end": 481.65,
"dtw": 477.28,
"start2": 477.28
},
{
"text": "Drei Monate hab ich auf diesem Kutter gearbeitet.",
"para": 51,
"head": false,
"n": 43,
"start": 482.5,
"end": 485.13,
"dtw": 482.52,
"start2": 482.5
},
{
"text": "Netze geflickt, das Deck repariert, Fisch ausgenommen.",
"para": 51,
"head": false,
"n": 47,
"start": 485.63,
"end": 487.91,
"dtw": 485.68,
"start2": 485.63
},
{
"text": "Mit dem ersten Lohn hab ich mir die Haare schneiden lassen und mir einen Bart wachsen lassen.",
"para": 51,
"head": false,
"n": 78,
"start": 488.23,
"end": 492.75,
"dtw": 489.88,
"start2": 489.89
},
{
"text": "Niemand hätte mich mehr erkannt.",
"para": 51,
"head": false,
"n": 29,
"start": 493.11,
"end": 494.68,
"dtw": 495.12,
"start2": 495.12
},
{
"text": "Im Juni hab ich Hinnerk gefragt, ob wir mal nach Möwenholm fahren.",
"para": 52,
"head": false,
"n": 55,
"start": 495.12,
"end": 498.72,
"dtw": 497.16,
"start2": 497.2
},
{
"text": "„Da soll's gute Heringsschwärme geben.",
"para": 52,
"head": false,
"n": 33,
"start": 499.17,
"end": 501.89,
"dtw": 501.48,
"start2": 501.45
},
{
"text": "Er hat gegrinst.",
"para": 52,
"head": false,
"n": 15,
"start": 502.14,
"end": 504.79,
"dtw": 503.88,
"start2": 503.88
},
{
"text": "„Da gibt's nur Möwen und Steine.",
"para": 52,
"head": false,
"n": 26,
"start": 505.33,
"end": 507.35,
"dtw": 505.36,
"start2": 505.33
},
{
"text": "Aber er ist trotzdem gefahren.",
"para": 52,
"head": false,
"n": 27,
"start": 508.07,
"end": 509.77,
"dtw": 508.08,
"start2": 508.07
},
{
"text": "Teil 8: Der Schatz",
"para": 53,
"head": true,
"n": 19,
"start": 510.51,
"end": 511.42,
"dtw": 510.52,
"start2": 510.51
},
{
"text": "Möwenholm war genau so, wie Anselm es beschrieben hatte.",
"para": 54,
"head": false,
"n": 48,
"start": 512.02,
"end": 516.15,
"dtw": 512.64,
"start2": 512.64
},
{
"text": "Kahl, windig, und oben auf dem Hügel ein alter, kaputter Leuchtturm.",
"para": 54,
"head": false,
"n": 56,
"start": 516.57,
"end": 522.49,
"dtw": 516.56,
"start2": 516.57
},
{
"text": "Ich hab gewartet, bis es dunkel war.",
"para": 55,
"head": false,
"n": 30,
"start": 523.07,
"end": 524.91,
"dtw": 523.08,
"start2": 523.07
},
{
"text": "Dann hab ich mich an die Tür vom Leuchtturm gestellt, den Polarstern gesucht und bin losgegangen.",
"para": 55,
"head": false,
"n": 82,
"start": 525.62,
"end": 531.79,
"dtw": 525.64,
"start2": 525.62
},
{
"text": "Vierzig Schritte.",
"para": 55,
"head": false,
"n": 17,
"start": 532.31,
"end": 533.5,
"dtw": 532.32,
"start2": 532.31
},
{
"text": "Da war er.",
"para": 56,
"head": false,
"n": 9,
"start": 534.3,
"end": 535.13,
"dtw": 534.32,
"start2": 534.3
},
{
"text": "Ein Felsen, halb im Gras versteckt.",
"para": 56,
"head": false,
"n": 30,
"start": 535.55,
"end": 537.65,
"dtw": 535.56,
"start2": 535.55
},
{
"text": "Und drauf, ganz verwittert, ein eingeritztes Kreuz.",
"para": 56,
"head": false,
"n": 44,
"start": 538.21,
"end": 542.2,
"dtw": 538.28,
"start2": 538.21
},
{
"text": "Ich hab mit bloßen Händen gegraben.",
"para": 57,
"head": false,
"n": 31,
"start": 542.82,
"end": 544.66,
"dtw": 542.84,
"start2": 542.82
},
{
"text": "Mit einem Stück Treibholz.",
"para": 57,
"head": false,
"n": 24,
"start": 544.96,
"end": 546.52,
"dtw": 544.96,
"start2": 544.96
},
{
"text": "Mit den Fingernägeln.",
"para": 57,
"head": false,
"n": 20,
"start": 546.81,
"end": 547.92,
"dtw": 546.84,
"start2": 546.81
},
{
"text": "Nach einer Stunde hab ich Holz gespürt.",
"para": 57,
"head": false,
"n": 34,
"start": 548.56,
"end": 550.93,
"dtw": 548.56,
"start2": 548.56
},
{
"text": "Eine Kiste, mit Eisen beschlagen und mit Teer versiegelt.",
"para": 57,
"head": false,
"n": 49,
"start": 551.31,
"end": 554.51,
"dtw": 551.32,
"start2": 551.31
},
{
"text": "Als ich den Deckel aufgemacht hab, hat das Mondlicht reingeschienen.",
"para": 58,
"head": false,
"n": 59,
"start": 555.11,
"end": 559.5,
"dtw": 555.12,
"start2": 555.11
},
{
"text": "Goldmünzen.",
"para": 58,
"head": false,
"n": 12,
"start": 560.03,
"end": 560.61,
"dtw": 558.76,
"start2": 558.74
},
{
"text": "Hunderte.",
"para": 58,
"head": false,
"n": 10,
"start": 561.03,
"end": 561.85,
"dtw": 560.08,
"start2": 560.03
},
{
"text": "Rubine, Smaragde, Perlenketten.",
"para": 58,
"head": false,
"n": 28,
"start": 562.13,
"end": 563.94,
"dtw": 561.04,
"start2": 561.03
},
{
"text": "Und ganz oben, in Wachstuch gewickelt, ein Brief.",
"para": 58,
"head": false,
"n": 41,
"start": 564.42,
"end": 567.38,
"dtw": 564.44,
"start2": 564.42
},
{
"text": "„Für den, der meinen Weg zu Ende geht.",
"para": 59,
"head": false,
"n": 30,
"start": 568.18,
"end": 570.24,
"dtw": 568.16,
"start2": 568.18
},
{
"text": "Mach etwas Gutes daraus.",
"para": 59,
"head": false,
"n": 22,
"start": 570.51,
"end": 571.93,
"dtw": 570.48,
"start2": 570.51
},
{
"text": "Dein Anselm.“",
"para": 59,
"head": false,
"n": 12,
"start": 572.4,
"end": 573.46,
"dtw": 572.44,
"start2": 572.4
},
{
"text": "Ich hab mich in die Erde gesetzt und geweint wie ein Kind.",
"para": 60,
"head": false,
"n": 48,
"start": 573.92,
"end": 577.48,
"dtw": 573.92,
"start2": 573.92
},
{
"text": "Teil 9: Die Wahrheit",
"para": 61,
"head": true,
"n": 21,
"start": 577.71,
"end": 578.85,
"dtw": 577.68,
"start2": 577.71
},
{
"text": "Ein halbes Jahr später kam ein Herr nach Lübeck.",
"para": 62,
"head": false,
"n": 41,
"start": 579.57,
"end": 583.36,
"dtw": 580.92,
"start2": 580.88
},
{
"text": "Gut gekleidet, mit Bart, einen Hut und einen Stock mit Silberknauf.",
"para": 62,
"head": false,
"n": 56,
"start": 583.78,
"end": 587.19,
"dtw": 583.8,
"start2": 583.78
},
{
"text": "Er nannte sich Herr Anselm.",
"para": 62,
"head": false,
"n": 24,
"start": 587.67,
"end": 589.31,
"dtw": 587.64,
"start2": 587.67
},
{
"text": "Er hat ein Haus am Wasser gekauft und sich einen Anwalt genommen, den besten der Stadt.",
"para": 62,
"head": false,
"n": 72,
"start": 589.71,
"end": 594.68,
"dtw": 589.72,
"start2": 589.71
},
{
"text": "Ich wollte keine Rache.",
"para": 63,
"head": false,
"n": 21,
"start": 595.27,
"end": 597.74,
"dtw": 595.32,
"start2": 595.27
},
{
"text": "Ich wollte die Wahrheit.",
"para": 63,
"head": false,
"n": 22,
"start": 598.22,
"end": 602.84,
"dtw": 596.56,
"start2": 596.56
},
{
"text": "Mein Anwalt hat die alten Gerichtsakten angefordert, mitsamt den gefälschten Briefen.",
"para": 64,
"head": false,
"n": 75,
"start": 603.17,
"end": 607.73,
"dtw": 598.36,
"start2": 598.22
},
{
"text": "Daneben haben wir Briefe von Konrad Haller gelegt, die er an Lieferanten geschrieben hatte.",
"para": 64,
"head": false,
"n": 78,
"start": 608.1,
"end": 611.32,
"dtw": 603.16,
"start2": 603.17
},
{
"text": "Und ich hab dem Richter gezeigt, was Anselm mir beigebracht hatte: dasselbe Zittern im Bogen vom „J“.",
"para": 64,
"head": false,
"n": 82,
"start": 611.73,
"end": 617.19,
"dtw": 608.12,
"start2": 608.1
},
{
"text": "Derselbe Druck auf dem Strich vom „t“.",
"para": 64,
"head": false,
"n": 31,
"start": 617.53,
"end": 618.51,
"dtw": 614.72,
"start2": 614.73
},
{
"text": "Dieselbe Tinte, eine billige Sorte, die damals nur im Kontor vom Reeder benutzt wurde.",
"para": 64,
"head": false,
"n": 72,
"start": 618.86,
"end": 623.68,
"dtw": 617.56,
"start2": 617.53
},
{
"text": "Dann kam ein alter Lagerarbeiter in den Zeugenstand.",
"para": 65,
"head": false,
"n": 46,
"start": 624.1,
"end": 627.29,
"dtw": 624.36,
"start2": 624.36
},
{
"text": "Er hatte Haller in der Brandnacht gesehen und all die Jahre geschwiegen, weil er Angst hatte.",
"para": 65,
"head": false,
"n": 78,
"start": 627.57,
"end": 632.28,
"dtw": 627.8,
"start2": 627.57
},
{
"text": "Konrad Haller wurde im Gerichtssaal ganz blass.",
"para": 66,
"head": false,
"n": 42,
"start": 632.92,
"end": 636.29,
"dtw": 632.92,
"start2": 632.92
},
{
"text": "Und dann hat er alles gestanden.",
"para": 66,
"head": false,
"n": 28,
"start": 636.92,
"end": 639.5,
"dtw": 636.96,
"start2": 636.92
},
{
"text": "Teil 10: Nach Hause",
"para": 67,
"head": true,
"n": 19,
"start": 640.12,
"end": 641.14,
"dtw": 640.08,
"start2": 640.12
},
{
"text": "Ich bin noch am selben Abend durch die alte Gasse am Hafen gelaufen, zu dem kleinen Haus mit den blauen Fensterläden.",
"para": 68,
"head": false,
"n": 97,
"start": 641.72,
"end": 649.3,
"dtw": 643.16,
"start2": 643.16
},
{
"text": "Greta hat die Tür aufgemacht.",
"para": 69,
"head": false,
"n": 26,
"start": 649.96,
"end": 651.56,
"dtw": 649.96,
"start2": 649.96
},
{
"text": "Sie war älter geworden, genau wie ich.",
"para": 69,
"head": false,
"n": 32,
"start": 651.96,
"end": 654.23,
"dtw": 651.96,
"start2": 651.96
},
{
"text": "In ihren Haaren waren ein paar graue Strähnen.",
"para": 69,
"head": false,
"n": 40,
"start": 654.64,
"end": 657.12,
"dtw": 654.64,
"start2": 654.64
},
{
"text": "Sie hat mich angeschaut und lange gar nichts gesagt.",
"para": 69,
"head": false,
"n": 45,
"start": 657.58,
"end": 660.25,
"dtw": 657.6,
"start2": 657.58
},
{
"text": "Dann hat sie mir die Hand auf die Wange gelegt.",
"para": 70,
"head": false,
"n": 39,
"start": 660.68,
"end": 662.83,
"dtw": 660.68,
"start2": 660.68
},
{
"text": "„Ich hab's immer gewusst“, hat sie geflüstert.",
"para": 70,
"head": false,
"n": 37,
"start": 663.5,
"end": 665.66,
"dtw": 663.48,
"start2": 663.5
},
{
"text": "„Ich hab nie geglaubt, dass du das warst.“",
"para": 70,
"head": false,
"n": 33,
"start": 665.91,
"end": 668.59,
"dtw": 666.16,
"start2": 665.91
},
{
"text": "Im Herbst 1912 haben wir geheiratet.",
"para": 71,
"head": false,
"n": 48,
"start": 669.09,
"end": 672.03,
"dtw": 669.04,
"start2": 669.09
},
{
"text": "Von Anselms Gold hab ich am Hafen eine Schule gebaut.",
"para": 71,
"head": false,
"n": 45,
"start": 672.41,
"end": 675.48,
"dtw": 672.32,
"start2": 672.41
},
{
"text": "Für Arbeiterkinder, die sonst nie lesen lernen würden.",
"para": 71,
"head": false,
"n": 47,
"start": 675.9,
"end": 679.16,
"dtw": 675.88,
"start2": 675.9
},
{
"text": "Mathematik, Sternkunde, Chemie, Sprachen.",
"para": 71,
"head": false,
"n": 36,
"start": 679.5,
"end": 682.29,
"dtw": 679.52,
"start2": 679.5
},
{
"text": "Alles, was er mir in der Dunkelheit beigebracht hat.",
"para": 71,
"head": false,
"n": 44,
"start": 682.62,
"end": 685.92,
"dtw": 683.56,
"start2": 683.57
},
{
"text": "Über dem Eingang steht in goldenen Buchstaben: „Weidner-Schule.",
"para": 72,
"head": false,
"n": 54,
"start": 686.51,
"end": 690.49,
"dtw": 686.52,
"start2": 686.51
},
{
"text": "Ein Kopf ist das Einzige, was sie dir nicht wegnehmen können.“",
"para": 72,
"head": false,
"n": 51,
"start": 691.01,
"end": 693.9,
"dtw": 691.0,
"start2": 691.01
},
{
"text": "Und manchmal, in klaren Nächten, steh ich mit den Kindern auf dem Dach und zeig ihnen den Polarstern.",
"para": 73,
"head": false,
"n": 83,
"start": 694.57,
"end": 700.54,
"dtw": 694.6,
"start2": 694.57
}
]