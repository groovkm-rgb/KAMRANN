 "phrases": [
  {
   "text": "Ein Schnellzug rollt in Tokio ein. Gleich steigen Hunderte Leute aus.",
   "s": 0.0,
   "e": 3.418
  },
  {
   "text": "Und Hunderte neue wollen rein. Dazwischen:",
   "s": 3.574,
   "e": 5.916
  },
  {
   "text": "sieben Minuten.",
   "s": 6.125,
   "e": 6.914
  },
  {
   "text": "Auf dem Bahnsteig wartet ein Team in Reih und Glied. Der Zug h\u00e4lt \u2013 und sie verbeugen sich.",
   "s": 7.183,
   "e": 10.938
  },
  {
   "text": "Vor dem Zug. Dann geht's los.",
   "s": 11.221,
   "e": 12.823
  },
  {
   "text": "Jede Person bekommt einen Wagen.",
   "s": 12.974,
   "e": 14.456
  },
  {
   "text": "Rund hundert Sitze.",
   "s": 14.778,
   "e": 15.8
  },
  {
   "text": "Allein.",
   "s": 15.942,
   "e": 16.34
  },
  {
   "text": "Anderthalb Minuten:",
   "s": 16.632,
   "e": 17.507
  },
  {
   "text": "M\u00fcll einsammeln, Gep\u00e4ckablagen checken. Drei\u00dfig Sekunden: alle Sitze umdrehen,",
   "s": 17.688,
   "e": 21.498
  },
  {
   "text": "damit sie in Fahrtrichtung zeigen.",
   "s": 21.633,
   "e": 22.936
  },
  {
   "text": "Vier Minuten:",
   "s": 23.187,
   "e": 24.128
  },
  {
   "text": "putzen,",
   "s": 24.327,
   "e": 24.675
  },
  {
   "text": "wischen, Kopfst\u00fctzenbez\u00fcge wechseln.",
   "s": 24.898,
   "e": 26.227
  },
  {
   "text": "Eine Minute: Kontrolle.",
   "s": 26.673,
   "e": 27.756
  },
  {
   "text": "Raus. Aufstellen. Verbeugen. Fertig.",
   "s": 27.976,
   "e": 30.225
  },
  {
   "text": "In Japan nennen sie das das \u201eSieben-Minuten-Theater\".",
   "s": 30.537,
   "e": 33.326
  },
  {
   "text": "Sogar in Harvard wird das studiert.",
   "s": 33.683,
   "e": 35.049
  },
  {
   "text": "Und das Krasseste?",
   "s": 35.483,
   "e": 36.377
  },
  {
   "text": "Fr\u00fcher hatte genau dieser Job ein ziemlich mieses Image.",
   "s": 36.705,
   "e": 39.565
  },
  {
   "text": "Ge\u00e4ndert hat sich vor allem eins:",
   "s": 39.894,
   "e": 41.273
  },
  {
