 "phrases": [
  {
   "text": "Ein Mann l\u00e4uft durch die Stra\u00dfen von San Francisco.",
   "s": 0.0,
   "e": 2.55
  },
  {
   "text": "Blaue Uniform,",
   "s": 2.907,
   "e": 3.701
  },
  {
   "text": "goldene Schulterklappen,",
   "s": 4.035,
   "e": 5.116
  },
  {
   "text": "ein S\u00e4bel an der Seite.",
   "s": 5.347,
   "e": 6.514
  },
  {
   "text": "Und die Leute verbeugen sich vor ihm.",
   "s": 6.858,
   "e": 8.5
  },
  {
   "text": "Denn er ist \u2026 der Kaiser von Amerika.",
   "s": 8.914,
   "e": 12.003
  },
  {
   "text": "Na ja.",
   "s": 12.475,
   "e": 12.883
  },
  {
   "text": "Sagt er zumindest.",
   "s": 13.277,
   "e": 14.131
  },
  {
   "text": "Eigentlich war er mal ein reicher Gesch\u00e4ftsmann.",
   "s": 14.494,
   "e": 16.641
  },
  {
   "text": "Dann verliert er alles.",
   "s": 16.98,
   "e": 18.038
  },
  {
   "text": "Und eines Tages schickt er einen Brief an die Zeitung:",
   "s": 18.473,
   "e": 20.645
  },
  {
   "text": "Ab heute bin ich Kaiser.",
   "s": 21.017,
   "e": 22.267
  },
  {
   "text": "Die Zeitung druckt das.",
   "s": 22.734,
   "e": 23.569
  },
  {
   "text": "Einfach so.",
   "s": 23.893,
   "e": 24.484
  },
  {
   "text": "Sein erster Befehl?",
   "s": 24.959,
   "e": 25.99
  },
  {
   "text": "Er l\u00f6st den Kongress auf.",
   "s": 26.15,
   "e": 27.144
  },
  {
   "text": "Der Kongress macht nat\u00fcrlich einfach weiter.",
   "s": 27.422,
   "e": 29.029
  },
  {
   "text": "Er druckt sein eigenes Geld.",
   "s": 29.287,
   "e": 30.39
  },
  {
   "text": "Und viele L\u00e4den nehmen es tats\u00e4chlich an.",
   "s": 30.703,
   "e": 32.466
  },
  {
   "text": "Einmal wird er sogar verhaftet.",
   "s": 32.739,
   "e": 34.258
  },
  {
   "text": "Die ganze Stadt regt sich auf.",
   "s": 34.452,
   "e": 35.675
  },
  {
   "text": "Er kommt sofort frei.",
   "s": 35.91,
   "e": 36.829
  },
  {
   "text": "Und es hei\u00dft,",
   "s": 37.11,
   "e": 37.593
  },
  {
   "text": "ab da salutieren die Polizisten vor ihm.",
   "s": 37.912,
   "e": 39.935
  },
  {
   "text": "Dann befiehlt er:",
   "s": 40.258,
   "e": 41.107
  },
  {
   "text": "Baut eine Br\u00fccke \u00fcber die Bucht! Alle lachen.",
   "s": 41.536,
   "e": 43.449
  },
  {
   "text": "Heute steht sie da.",
   "s": 43.834,
   "e": 44.682
  },
  {
   "text": "Und als er stirbt, kommen Tausende zu seiner Beerdigung.",
   "s": 44.874,
   "e": 47.492
  },
  {
   "text": "F\u00fcr einen Kaiser \u2026 ohne Reich.",
   "s": 47.871,
   "e": 49.761
  }
 ]
