 "phrases": [
  {
   "text": "Dieser Krieg hatte genau ein Opfer.",
   "s": 0.14,
   "e": 1.74
  },
  {
   "text": "Ein Schwein.",
   "s": 1.96,
   "e": 2.56
  },
  {
   "text": "Eine kleine Insel.",
   "s": 2.68,
   "e": 3.59
  },
  {
   "text": "Zwei Großmächte behaupten:",
   "s": 3.95,
   "e": 5.23
  },
  {
   "text": "Die gehört uns.",
   "s": 5.63,
   "e": 6.47
  },
  {
   "text": "Und auf der Insel leben Siedler von beiden Seiten.",
   "s": 6.76,
   "e": 8.86
  },
  {
   "text": "Eines Tages steht ein Schwein im Kartoffelacker eines Farmers.",
   "s": 9.17,
   "e": 11.8
  },
  {
   "text": "Nicht zum ersten Mal.",
   "s": 12.08,
   "e": 13.0
  },
  {
   "text": "Der Farmer verliert die Geduld –",
   "s": 13.41,
   "e": 14.62
  },
  {
   "text": "und erschießt es.",
   "s": 14.83,
   "e": 15.67
  },
  {
   "text": "Das Problem:",
   "s": 16.06,
   "e": 16.65
  },
  {
   "text": "Das Schwein gehört …",
   "s": 17.06,
   "e": 17.96
  },
  {
   "text": "der anderen Seite.",
   "s": 18.21,
   "e": 19.02
  },
  {
   "text": "Der Farmer will zahlen.",
   "s": 19.38,
   "e": 20.26
  },
  {
   "text": "Der Besitzer lehnt ab.",
   "s": 20.64,
   "e": 21.58
  },
  {
   "text": "Man droht, ihn zu verhaften.",
   "s": 21.88,
   "e": 23.11
  },
  {
   "text": "Die Siedler rufen die Armee.",
   "s": 23.43,
   "e": 24.6
  },
  {
   "text": "Es kommen Soldaten.",
   "s": 24.95,
   "e": 25.81
  },
  {
   "text": "Dann Kanonen.",
   "s": 26.09,
   "e": 26.69
  },
  {
   "text": "Die andere Seite schickt Kriegsschiffe.",
   "s": 27.0,
   "e": 28.54
  },
  {
   "text": "Mit über zweitausend Mann.",
   "s": 28.81,
   "e": 29.96
  },
  {
   "text": "Doch der Admiral weigert sich anzugreifen.",
   "s": 30.51,
   "e": 32.34
  },
  {
   "text": "Er will keinen Krieg zwischen zwei großen Nationen …",
   "s": 32.71,
   "e": 34.72
  },
  {
   "text": "wegen eines Schweins.",
   "s": 34.99,
   "e": 35.94
  },
  {
   "text": "Also teilen sich beide Armeen die Insel.",
   "s": 36.43,
   "e": 38.06
  },
  {
   "text": "Zwölf Jahre lang.",
   "s": 38.3,
   "e": 39.17
  },
  {
   "text": "Ohne einen einzigen Schuss.",
   "s": 39.43,
   "e": 40.85
  },
  {
   "text": "Und wer entscheidet am Ende, wem die Insel gehört?",
   "s": 41.25,
   "e": 43.52
  },
  {
   "text": "Ein deutscher Kaiser.",
   "s": 43.96,
   "e": 44.86
  },
  {
   "text": "Bilanz des Krieges:",
   "s": 45.09,
   "e": 46.03
  },
  {
   "text": "ein totes Schwein.",
