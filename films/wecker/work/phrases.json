 "phrases": [
  {
   "text": "Drei Uhr nachts.",
   "s": 0.12,
   "e": 0.737
  },
  {
   "text": "Eine Frau schleicht durch eine dunkle Stra\u00dfe.",
   "s": 1.037,
   "e": 3.074
  },
  {
   "text": "Sie hebt ein Rohr an den Mund \u2026 zielt auf ein Fenster \u2026 und pustet.",
   "s": 3.573,
   "e": 7.259
  },
  {
   "text": "Pling!",
   "s": 7.763,
   "e": 8.373
  },
  {
   "text": "Eine getrocknete Erbse.",
   "s": 8.737,
   "e": 10.045
  },
  {
   "text": "Direkt gegen die Scheibe.",
   "s": 10.628,
   "e": 11.88
  },
  {
   "text": "Eine Einbrecherin?",
   "s": 12.058,
   "e": 13.037
  },
  {
   "text": "Nein.",
   "s": 13.504,
   "e": 13.793
  },
  {
   "text": "Sie ist ein Wecker.",
   "s": 14.429,
   "e": 15.285
  },
  {
   "text": "Ein menschlicher Wecker.",
   "s": 15.657,
   "e": 16.77
  },
  {
   "text": "Wecker sind damals teuer,",
   "s": 17.055,
   "e": 18.104
  },
  {
   "text": "und nicht jeder hat einen.",
   "s": 18.237,
   "e": 19.143
  },
  {
   "text": "Aber wer zu sp\u00e4t in die Fabrik kommt, kriegt \u00c4rger.",
   "s": 19.529,
   "e": 21.729
  },
  {
   "text": "Oder fliegt raus.",
   "s": 22.068,
   "e": 22.972
  },
  {
   "text": "Also zahlen die Leute ein paar M\u00fcnzen pro Woche.",
   "s": 23.364,
   "e": 25.647
  },
  {
   "text": "Und jeden Morgen kommt jemand und klopft ans Fenster.",
   "s": 26.057,
   "e": 28.397
  },
  {
   "text": "Mit einem langen Stock.",
   "s": 28.793,
   "e": 30.043
  },
  {
   "text": "Oder eben mit Erbsen.",
   "s": 30.521,
   "e": 31.859
  },
  {
   "text": "Und er geht erst weiter, wenn du wirklich wach bist.",
   "s": 32.157,
   "e": 34.153
  },
  {
   "text": "Aber wer weckt eigentlich \u2026 den Wecker?",
   "s": 34.536,
   "e": 36.136
  },
  {
   "text": "Die meisten schlafen einfach tags\u00fcber.",
   "s": 36.742,
   "e": 39.506
  },
  {
   "text": "Und es gab sogar einen Zungenbrecher dar\u00fcber:",
   "s": 39.767,
   "e": 41.661
  },
  {
   "text": "Unser Wecker hatte einen Wecker.",
   "s": 42.01,
   "e": 43.828
  },
  {
   "text": "Aber der Wecker vom Wecker hat unseren Wecker nicht geweckt.",
   "s": 44.339,
   "e": 47.788
  },
  {
   "text": "Also hat unser Wecker uns nicht geweckt.",
   "s": 48.006,
   "e": 49.883
  }
 ]
