 ],
 "phrases": [
  {
   "text": "Der erfolgreichste Spion dieses Krieges \u2026 war schon tot,",
   "s": 0.135,
   "e": 1.882
  },
  {
   "text": "bevor seine Mission begann.",
   "s": 2.31,
   "e": 4.422
  },
  {
   "text": "Eine Armee plant einen Angriff auf eine Insel.",
   "s": 4.975,
   "e": 7.169
  },
  {
   "text": "Der Feind darf es auf keinen Fall merken.",
   "s": 7.463,
   "e": 9.367
  },
  {
   "text": "Also brauchen sie \u2026 eine Leiche.",
   "s": 9.608,
   "e": 11.632
  },
  {
   "text": "Sie finden einen Toten ohne Angeh\u00f6rige.",
   "s": 11.965,
   "e": 13.976
  },
  {
   "text": "Ziehen ihm eine Offiziersuniform an.",
   "s": 14.338,
   "e": 16.08
  },
  {
   "text": "Und erfinden ihm ein ganzes Leben:",
   "s": 16.41,
   "e": 18.102
  },
  {
   "text": "Liebesbriefe seiner Verlobten,",
   "s": 18.437,
   "e": 19.971
  },
  {
   "text": "Theaterkarten, die Quittung f\u00fcr einen Verlobungsring.",
   "s": 20.261,
   "e": 22.652
  },
  {
   "text": "Sogar einen Mahnbrief seiner Bank.",
   "s": 23.026,
   "e": 24.695
  },
  {
   "text": "Und an ihm festgekettet:",
   "s": 25.005,
   "e": 26.12
  },
  {
   "text": "eine Aktentasche.",
   "s": 26.303,
   "e": 27.088
  },
  {
   "text": "Darin streng geheime Pl\u00e4ne.",
   "s": 27.535,
   "e": 28.737
  },
  {
   "text": "Alle falsch.",
   "s": 28.953,
   "e": 29.555
  },
  {
   "text": "Nachts l\u00e4sst ihn ein U-Boot vor einer K\u00fcste ins Meer gleiten.",
   "s": 29.998,
   "e": 32.383
  },
  {
   "text": "Am Morgen findet ihn ein Fischer.",
   "s": 32.751,
   "e": 33.942
  },
  {
   "text": "Die Papiere landen beim Feind.",
   "s": 34.371,
   "e": 35.569
  },
  {
   "text": "Und der glaubt jedes Wort.",
   "s": 35.789,
   "e": 36.824
  },
  {
   "text": "Er schickt Truppen an die falschen Orte.",
   "s": 37.172,
   "e": 38.576
  },
  {
   "text": "Als der echte Angriff kommt, stehen viele seiner Soldaten ganz woanders. Der Mann,",
   "s": 38.88,
   "e": 41.575
  },
  {
   "text": "der nie existierte \u2026 hat vermutlich Tausende Leben gerettet.",
   "s": 41.905,
   "e": 44.79
  }
 ]
}