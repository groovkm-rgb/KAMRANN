 "phrases": [
  {
   "text": "Stell dir vor, du bist Arzt.",
   "s": 0.0,
   "e": 1.662
  },
  {
   "text": "Vor zweihundert Jahren.",
   "s": 1.861,
   "e": 2.932
  },
  {
   "text": "Dein erster Patient hat Fieber.",
   "s": 3.221,
   "e": 4.73
  },
  {
   "text": "Was machst du? Ganz klar: Blut abnehmen. Viel Blut.",
   "s": 4.999,
   "e": 7.59
  },
  {
   "text": "Oder du setzt ihm Blutegel an.",
   "s": 7.83,
   "e": 9.134
  },
  {
   "text": "Die sollen das \u201eschlechte Blut\u201c rausholen.",
   "s": 9.392,
   "e": 11.277
  },
  {
   "text": "Danach gehst du direkt r\u00fcber zu den Frauen, die gerade ein Baby bekommen.",
   "s": 11.513,
   "e": 14.564
  },
  {
   "text": "H\u00e4nde waschen?",
   "s": 14.692,
   "e": 15.261
  },
  {
   "text": "Wozu?",
   "s": 15.573,
   "e": 16.037
  },
  {
   "text": "Vorher hast du noch an Leichen gearbeitet \u2026 aber egal.",
   "s": 16.455,
   "e": 19.031
  },
  {
   "text": "Dann kommt ein Kollege und sagt:",
   "s": 19.377,
   "e": 20.701
  },
  {
   "text": "Wascht euch die H\u00e4nde!",
   "s": 20.857,
   "e": 21.706
  },
  {
   "text": "Dann sterben weniger M\u00fctter.",
   "s": 21.894,
   "e": 23.129
  },
  {
   "text": "Und er hat recht.",
   "s": 23.464,
   "e": 24.283
  },
  {
   "text": "Die Zahlen gehen sofort runter.",
   "s": 24.613,
   "e": 25.955
  },
  {
   "text": "Und was machen die anderen \u00c4rzte?",
   "s": 26.369,
   "e": 27.796
  },
  {
   "text": "Sie lachen ihn aus.",
   "s": 28.244,
   "e": 29.132
  },
  {
   "text": "Und wenn jemand halb ertrunken aus dem Fluss gezogen wird?",
   "s": 29.589,
   "e": 32.018
  },
  {
   "text": "Daf\u00fcr liegt am Ufer ein Notfallkoffer bereit.",
   "s": 32.335,
   "e": 34.377
  },
  {
   "text": "Mit einem Blasebalg.",
   "s": 34.606,
   "e": 35.628
  },
  {
   "text": "Damit pustest du dem Patienten Tabakrauch \u2026 in den Hintern.",
   "s": 35.95,
   "e": 38.843
  },
  {
   "text": "Kein Witz.",
   "s": 39.086,
   "e": 39.644
  },
  {
   "text": "Damals hie\u00df das:",
   "s": 40.23,
   "e": 41.031
  },
  {
   "text": "Erste Hilfe.",
   "s": 41.294,
   "e": 41.947
  }
 ]
