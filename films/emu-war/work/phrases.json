 "phrases": [
  {
   "text": "Ein Land schickt seine Armee in den Krieg.",
   "s": 0.0,
   "e": 1.92,
   "f0": 0,
   "f1": 58
  },
  {
   "text": "Gegen …",
   "s": 2.05,
   "e": 2.4,
   "f0": 61,
   "f1": 72
  },
  {
   "text": "Vögel.",
   "s": 2.65,
   "e": 3.09,
   "f0": 80,
   "f1": 93
  },
  {
   "text": "Und verliert.",
   "s": 3.31,
   "e": 3.94,
   "f0": 99,
   "f1": 118
  },
  {
   "text": "Zwanzigtausend Emus",
   "s": 4.24,
   "e": 5.3,
   "f0": 127,
   "f1": 159
  },
  {
   "text": "fressen die Weizenfelder kahl.",
   "s": 5.49,
   "e": 6.87,
   "f0": 165,
   "f1": 206
  },
  {
   "text": "Die Farmer wollen Maschinengewehre.",
   "s": 7.2,
   "e": 8.57,
   "f0": 216,
   "f1": 257
  },
  {
   "text": "Sie bekommen sie.",
   "s": 8.75,
   "e": 9.48,
   "f0": 262,
   "f1": 284
  },
  {
   "text": "Dazu Soldaten und zehntausend Schuss Munition.",
   "s": 9.83,
   "e": 12.12,
   "f0": 295,
   "f1": 364
  },
  {
   "text": "Erster Versuch:",
   "s": 12.51,
   "e": 13.23,
   "f0": 375,
   "f1": 397
  },
  {
   "text": "Die Emus teilen sich in kleine Gruppen auf",
   "s": 13.4,
   "e": 15.03,
   "f0": 402,
   "f1": 451
  },
  {
   "text": "und rennen in alle Richtungen davon.",
   "s": 15.06,
   "e": 16.57,
   "f0": 452,
   "f1": 497
  },
  {
   "text": "Zweiter Versuch:",
   "s": 16.86,
   "e": 17.58,
   "f0": 506,
   "f1": 527
  },
  {
   "text": "ein Hinterhalt.",
   "s": 17.72,
   "e": 18.39,
   "f0": 532,
   "f1": 552
  },
  {
   "text": "Über tausend Emus kommen näher.",
   "s": 18.6,
   "e": 19.94,
   "f0": 558,
   "f1": 598
  },
  {
   "text": "Feuer!",
   "s": 19.96,
   "e": 20.4,
   "f0": 599,
   "f1": 612
  },
  {
   "text": "Nach ein paar Vögeln:",
   "s": 20.7,
   "e": 21.63,
   "f0": 621,
   "f1": 649
  },
  {
   "text": "Ladehemmung.",
   "s": 21.78,
   "e": 22.42,
   "f0": 653,
   "f1": 673
  },
  {
   "text": "Dritter Versuch:",
   "s": 22.46,
   "e": 23.18,
   "f0": 674,
   "f1": 695
  },
  {
   "text": "das Maschinengewehr auf einem Lastwagen.",
   "s": 23.34,
   "e": 24.95,
   "f0": 700,
   "f1": 748
  },
  {
   "text": "Aber der ist zu langsam.",
   "s": 25.08,
   "e": 26.22,
   "f0": 752,
   "f1": 787
  },
  {
   "text": "Und so holprig, dass der Schütze nicht mal schießen kann.",
   "s": 26.36,
   "e": 28.72,
   "f0": 791,
   "f1": 862
  },
  {
   "text": "Die Armee zieht ab.",
   "s": 29.29,
   "e": 30.12,
   "f0": 879,
   "f1": 904
  },
  {
   "text": "Kommt zurück.",
   "s": 30.22,
   "e": 30.74,
   "f0": 907,
   "f1": 922
  },
  {
   "text": "Am Ende:",
   "s": 30.96,
   "e": 31.47,
   "f0": 929,
   "f1": 944
  },
  {
   "text": "fast zehntausend Schuss.",
