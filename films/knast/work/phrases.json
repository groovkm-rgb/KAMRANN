 "phrases": [
  {
   "text": "Aus dem Knast ausbrechen?",
   "s": 0.0,
   "e": 1.181
  },
  {
   "text": "In Deutschland ist das nicht mal strafbar.",
   "s": 1.5,
   "e": 2.999
  },
  {
   "text": "Kein Witz.",
   "s": 3.316,
   "e": 3.832
  },
  {
   "text": "Stell dir vor:",
   "s": 4.125,
   "e": 4.746
  },
  {
   "text": "Nachts.",
   "s": 4.887,
   "e": 5.334
  },
  {
   "text": "Deine Zelle.",
   "s": 5.584,
   "e": 6.203
  },
  {
   "text": "Der W\u00e4rter hat vergessen abzuschlie\u00dfen.",
   "s": 6.599,
   "e": 8.304
  },
  {
   "text": "Du rennst los \u2013 \u00fcber den Hof,",
   "s": 8.674,
   "e": 10.229
  },
  {
   "text": "\u00fcber die Mauer.",
   "s": 10.473,
   "e": 11.15
  },
  {
   "text": "Frei.",
   "s": 11.48,
   "e": 11.883
  },
  {
   "text": "Drei Tage sp\u00e4ter schnappt dich die Polizei.",
   "s": 12.326,
   "e": 14.175
  },
  {
   "text": "Jetzt gibt's richtig \u00c4rger, oder?",
   "s": 14.492,
   "e": 16.02
  },
  {
   "text": "N\u00f6.",
   "s": 16.463,
   "e": 16.715
  },
  {
   "text": "F\u00fcr die Flucht selbst kriegst du keinen einzigen Tag extra.",
   "s": 17.106,
   "e": 19.902
  },
  {
   "text": "Denn das deutsche Recht sagt:",
   "s": 20.271,
   "e": 21.478
  },
  {
   "text": "Jeder Mensch will frei sein.",
   "s": 21.755,
   "e": 23.079
  },
  {
   "text": "Das ist ein Urinstinkt \u2013 und daf\u00fcr bestraft man niemanden.",
   "s": 23.336,
   "e": 26.523
  },
  {
   "text": "Aber jetzt kommt der Haken.",
   "s": 26.909,
   "e": 28.479
  },
  {
   "text": "Gitter durchges\u00e4gt?",
   "s": 28.945,
   "e": 29.961
  },
  {
   "text": "Sachbesch\u00e4digung.",
   "s": 30.272,
   "e": 31.222
  },
  {
   "text": "Die Uniform vom W\u00e4rter mitgehen lassen?",
   "s": 31.622,
   "e": 33.282
  },
  {
   "text": "Diebstahl.",
   "s": 33.758,
   "e": 34.25
  },
  {
   "text": "Dein Kumpel hat das Fluchtauto gefahren?",
   "s": 34.672,
   "e": 36.447
  },
  {
   "text": "Der ist dran.",
   "s": 36.809,
   "e": 37.548
  },
  {
   "text": "Ihr wart zu dritt und habt Gewalt benutzt?",
   "s": 38.037,
   "e": 39.755
  },
  {
   "text": "Gefangenenmeuterei.",
   "s": 40.214,
   "e": 41.33
  },
  {
   "text": "Und deine alte Strafe?",
   "s": 41.798,
   "e": 43.075
  },
  {
   "text": "Die sitzt du nat\u00fcrlich trotzdem ab.",
   "s": 43.544,
   "e": 45.024
  },
  {
   "text": "Ausbrechen ist also erlaubt.",
   "s": 45.357,
   "e": 46.587
  },
  {
   "text": "Du musst es nur schaffen,",
   "s": 46.961,
   "e": 49.016
  },
  {
   "text": "ohne was kaputt zu machen,",
   "s": 49.34,
   "e": 50.16
  },
  {
   "text": "ohne was zu klauen\u2026 und ganz allein.",
